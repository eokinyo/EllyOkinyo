{
  "hosting": {
    "public": ".",
    "predeploy": [
      "node scripts/check-deploy.js",
      "node scripts/test-public-surface.js",
      "node scripts/publish-owner-ui.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      ".gitignore",
      ".firebaserc",
      ".firebase/**",
      "**/.git/**",
      ".git/**",
      "**/node_modules/**",
      "theme-preview.html",
      "dev/**",
      "scripts/**",
      "firestore.rules",
      "firestore.indexes.json",
      "owner-ui.js",
      "**/*.md",
      "package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "**/*.log"
    ],
    "rewrites": [
      {
        "source": "!/**/owner-ui.js",
        "destination": "/index.html"
      }
    ]
  }
}
